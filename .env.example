# Public. The browser bundle can see these.
# Use the project URL, and the anon key or the newer publishable key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Set this in the Vercel project environment.
# Use the service_role key or the newer secret key.
# Do not prefix this name with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Public VAPID key. Safe in the browser. Generate with:
# npx web-push generate-vapid-keys
# Inlined at build time, so set it before the Vercel build.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Server only. Do not prefix these with NEXT_PUBLIC_. Do not commit values.
# VAPID_SUBJECT is a mailto: or https: contact, for example mailto:you@example.com.
# NOTIFY_SECRET is a long random string. Callers send it as the x-notify-secret header.
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
NOTIFY_SECRET=

# Server only. Encrypts provider API keys at rest. 32 bytes, base64.
# Generate with: openssl rand -base64 32
# Do not prefix this name with NEXT_PUBLIC_. Do not commit a real value.
API_KEYS_ENCRYPTION_KEY=
